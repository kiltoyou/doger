// Схема базы данных Doger
// Запуск: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String
  avatarColor  String   @default("#2D7CFF")
  avatarUrl    String?
  status       String   @default("offline") // online | offline | away
  mood         String?
  isPremium    Boolean  @default(false)
  createdAt    DateTime @default(now())

  chatMemberships   ChatMember[]
  sentMessages      Message[]
  liveParticipation LiveRoomParticipant[]
  achievements      UserAchievement[]
  notifications     Notification[]
}

model Chat {
  id        String   @id @default(uuid())
  type      String // direct | group | channel
  name      String?
  createdAt DateTime @default(now())

  members  ChatMember[]
  messages Message[]
  liveRoom LiveRoom?
}

model ChatMember {
  id     String @id @default(uuid())
  chatId String
  userId String
  role   String @default("member") // owner | admin | member

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  type      String   @default("text") // text | voice | file | image
  content   String? // текст сообщения
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  duration  Int? // для voice, в секундах
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model LiveRoom {
  id           String   @id @default(uuid())
  chatId       String   @unique
  title        String   @default("Live Room")
  mediaUrl     String? // ссылка на совместный просмотр
  mediaTitle   String?
  mediaElapsed Int      @default(0) // секунды
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  chat         Chat                   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  participants LiveRoomParticipant[]
}

model LiveRoomParticipant {
  id         String   @id @default(uuid())
  liveRoomId String
  userId     String
  cameraOn   Boolean  @default(false)
  micOn      Boolean  @default(true)
  screenOn   Boolean  @default(false)
  joinedAt   DateTime @default(now())

  liveRoom LiveRoom @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveRoomId, userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // message | mention | live | achievement
  title     String
  subtitle  String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String
  icon        String // имя иконки lucide-react
  color       String

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}
