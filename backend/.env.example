# Локально для разработки и в проде используем одну и ту же облачную базу (Neon),
# чтобы у тебя и у друга был ОБЩИЙ мессенджер, а не два разных.
# Строку подключения возьми в Neon: Dashboard → Connection string (с ?sslmode=require в конце)
DATABASE_URL="postgresql://user:password@host.neon.tech/doger?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
